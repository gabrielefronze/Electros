{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for Electros Tauri",
  "windows": ["main", "ssh-*", "rdp-*", "popup-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom",
    "core:webview:default",
    "core:app:default",
    "core:path:default",
    "core:resources:default",
    "opener:default",
    "dialog:default",
    "shell:default",
    "deep-link:default",
    "core:tray:default"
  ]
}
